{
  "name": "class-validator-is-nullable",
  "version": "1.0.0",
  "description": "@IsNullable and @IsUndefinable decorators for class-validator",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    }
  },
  "files": [
    "lib"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepublishOnly": "npm run build",
    "test": "tsx --tsconfig tsconfig.tsx.json --test test/*.spec.ts",
    "examples": "tsx --tsconfig tsconfig.tsx.json examples/nullable.ts && tsx --tsconfig tsconfig.tsx.json examples/undefinable.ts && tsx --tsconfig tsconfig.tsx.json examples/groups.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mentatxx/class-validator-is-nullable.git"
  },
  "keywords": [
    "validator",
    "validation",
    "typescript",
    "typescript-validator",
    "class-validator",
    "nullable",
    "undefinable"
  ],
  "author": {
    "name": "Alexey Petushkov",
    "email": "mentatxx@gmail.com"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/mentatxx/class-validator-is-nullable/issues"
  },
  "homepage": "https://github.com/mentatxx/class-validator-is-nullable#readme",
  "engines": {
    "node": ">=18"
  },
  "peerDependencies": {
    "class-validator": ">=0.14.0",
    "reflect-metadata": ">=0.1.13"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "class-validator": "^0.15.1",
    "reflect-metadata": "^0.2.2",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
